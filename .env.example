MONGO_URI=mongodb://localhost:27017/ukulele
SESSION_SECRET=change-me-for-production
API_PORT=5000
FRONTEND_URL=http://localhost:5173

# Production (API host, e.g. Render)
# NODE_ENV=production
# FRONTEND_URL=https://ukulele-nine.vercel.app
#
# Only if the browser calls the API host directly (no Vercel /api rewrite):
# CROSS_ORIGIN_COOKIES=true

# Production frontend (Vercel): leave VITE_API_URL unset so requests stay
# same-origin and vercel.json rewrites /api/* → https://ukulele.onrender.com.
# VITE_API_URL=

SEED_USER_EMAIL=noreply@myukulele.website
SEED_USER_PASSWORD=superSecretPassword
SEED_USER_SCREENNAME=SeedUser

# Password reset emails. Optional in development (the API logs a reset link
# and returns it as `resetUrl` when NODE_ENV is not production). Required
# in production to actually send mail. FRONTEND_URL is used in the link.
#
# Recommended: Resend (https://resend.com) + DNS at Porkbun. You do not need
# Porkbun email hosting. SMTP_* belong on the API host (Render), not Vercel.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxxx
# MAIL_FROM=My Ukulele Songbook <noreply@myukulele.website>
# EXPOSE_PASSWORD_RESET_LINK=false
