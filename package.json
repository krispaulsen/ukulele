{
  "name": "ukulele-songbook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "nodemon --watch server --ext js server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "seed:songs": "node ./server/seedSongs.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@material-tailwind/react": "^2.1.10",
    "@tailwindcss/vite": "^4.2.4",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.3",
    "nano": "^11.0.5",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.2.1",
    "jsdom": "^25.0.1",
    "nodemon": "^3.1.14",
    "vite": "^5.4.2",
    "vitest": "^2.1.8"
  }
}
